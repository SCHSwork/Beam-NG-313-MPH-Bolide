"bolide_turbo_velocita": {
    "information":{
        "authors":"BeamNG, Lincoln",
        "name":"Velocita Quick-Spool Twin Turbochargers",
        "value":19600,
    },
    "slotType" : "bolide_intake",
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$wastegateStart", "range", "psi", "Engine", 26, 12, 40, "Turbo Boost Pressure", "Pressure at which the turbocharger wastegate begins to open", {"stepDis":0.5}],
    ],
    "slots2": [
        ["name",                 "allowTypes",             "denyTypes", "default",                "description"],
        ["bolide_exhaust_turbo", ["bolide_exhaust_turbo"], [],          "bolide_exhaust_turbo_b", "Exhaust"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["bolide_intake_turbo", ["bolide_engine", "bolide_engine_intake", "bolide_headers"]],
         ["bolide_intercooler_R", ["bolide_intercooler_R", "bolide_subframe_R"]],
         ["bolide_intercooler_L", ["bolide_intercooler_L", "bolide_subframe_R"]],
    ],
    "turbocharger": {
        "bovSoundFileName":"event:>Vehicle>Forced_Induction>Turbo_07>turbo_flt_race",
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_07>turbo_hiss_race",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>Turbo_07>turbo_spin_race",
        "turboSizeCoef": 1.0,
        "bovSoundVolumeCoef":0.95,
        "hissVolumePerPSI": 0.06,
        "whineVolumePer10kRPM": 0.02,
        "whinePitchPer10kRPM": 0.042,
        "wastegateStart":"$wastegateStart",
        "wastegateLimit":"$=$wastegateStart+1",
        "maxExhaustPower": 120000,
        "backPressureCoef": 0.00008,
        "frictionCoef": 100,
        "inertia":3.2,
        "pressureRatePSI": 140,
        "damageThresholdTemperature": 1050
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,       -3.5],
            [30000,    1.5],
            [60000,      4],
            [90000,     11],
            [150000,    18],
            [200000,    25],
            [250000,    33],
            [300000,    40],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor  (tuned for fast spool)
            [0,     0.0,    0.0],
            [650,   0.35,   0.15],
            [1400,  0.55,   0.35],
            [2000,  0.75,   0.55],
            [3000,  0.92,   0.80],
            [4000,  0.95,   0.95],
            [5000,  0.97,   1.00],
            [6000,  0.98,   1.00],
            [7000,  0.97,   1.00],
            [8000,  0.95,   0.97],
            [8500,  0.90,   0.95],
            [9000,  0.82,   0.90],
            [10000, 0.65,   0.80],
        ],
    },
    "soundConfig": {
        "$+maxLoadMix": 0.15,
        "$+minLoadMix": 0.1,
        "$+intakeMuffling":-0.5,
        //"$+maingain": -0.5,
        "$+eqLowGain": 7,
    },
    "soundConfigExhaust": {
        "$+maxLoadMix": 0.2,
        "$+minLoadMix": 0.15,
        //"$+maingain": -0.5,
        "$+offLoadGain": 0.15,
    },
    "mainEngine":{
        //turbocharger name
        "turbocharger":"turbocharger",
        "$*instantAfterFireCoef": 3.4,
        "$*sustainedAfterFireCoef": 3.2,
        "$*sustainedAfterFireVolumeCoef": 1.8,

        //damage deformGroups
        "deformGroups_turbo":["mainEngine_turbo_R","mainEngine_turbo_L","mainEngine_intercooler_R","mainEngine_intercooler_L"]
    },
    "nodes": [
         ["id",      "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":false},
         //intake
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"nodeWeight":3.5},
         {"group":["bolide_engine","bolide_engine_intake"]},
         ["intck1r",-0.112,  0.556,  0.741],
         ["intck1l", 0.112,  0.556,  0.741],
         ["intck2r",-0.112,  1.033,  0.741],
         ["intck2l", 0.112,  1.033,  0.741],
