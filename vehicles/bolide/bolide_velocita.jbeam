        ["fx5l", "steeringrack", true, true, 0.0, 20001000, "FLT_MAX", "FLT_MAX"],
    ],
    "nodes": [
         ["id",   "posX", "posY", "posZ"],
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         //rack ends
         {"group":"bolide_tierod_F"},
         {"nodeWeight":4.5},
         ["fh6r",-0.404, -1.12,   0.335],
         ["fh6l", 0.404, -1.12,   0.335],
         //rack
         {"group":"bolide_rack_F"},
         {"nodeWeight":6.5},
         ["fx5r",-0.30,  -1.12,   0.335],
         ["fx5l", 0.30,  -1.12,   0.335],
         {"group":""},
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_F", "range", "", "Wheel Alignment", 0.995, 0.97, 1.02, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Front"}],
        ["$steer_center_F", "range", "", "Wheel Alignment", 0, -0.002, 0.002, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Front"}]
    ],
    "beams": [
            ["id1:", "id2:"],
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
            //rack
            {"beamSpring":8001000,"beamDamp":250,"beamDeform":65000,"beamStrength":275000},
            ["fh6r", "fh6l", {"vkTag":"steer_rack_F"}],
            {"beamSpring":5001000,"beamDamp":250},
            {"beamDeform":22400,"beamStrength":"FLT_MAX"},
            ["fx5l", "fx5r"],

            ["fx5l", "fx2l"],
            ["fx5r", "fx2r"],
            ["fx5l", "fx2r"],
            ["fx5r", "fx2l"],

            ["fx5l", "fx4l"],
            ["fx5r", "fx4r"],
            ["fx5l", "fx4r"],
            ["fx5r", "fx4l"],

            ["fx5l", "fx1l"],
            ["fx5r", "fx1r"],
            ["fx5l", "fx1r"],
            ["fx5r", "fx1l"],

            //tie rods
            {"beamSpring":18001000,"beamDamp":250,"beamDeform":65000,"beamStrength":275000},
            ["fh3r", "fh6r", {"vkTag":"steer_link_FR", "beamPrecompression":"$=$toe_F-$steer_center_F","beamPrecompressionTime":0.5}],
            ["fh3l", "fh6l", {"vkTag":"steer_link_FL", "beamPrecompression":"$=$toe_F+$steer_center_F","beamPrecompressionTime":0.5}],
            {"deformLimitExpansion":""},
            //steering dampener
            {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
            {"beamLimitSpring":0,"beamLimitDamp":0},
            {"beamSpring":0},
            {"beamDamp":25},
            ["fh3r", "fx3r", {"beamDampVelocitySplit":0.15,"beamDampFast":250,"dampCutoffHz":750}],
            ["fh3l", "fx3l", {"beamDampVelocitySplit":0.15,"beamDampFast":250,"dampCutoffHz":750}],
            ["fh3r", "fx4r", {"beamDampVelocitySplit":0.15,"beamDampFast":250,"dampCutoffHz":750}],
            ["fh3l", "fx4l", {"beamDampVelocitySplit":0.15,"beamDampFast":250,"dampCutoffHz":750}],
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
            {"deformLimitExpansion":1.2},
    ],
    "hydros": [
            ["id1:","id2:"],
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
            {"beamSpring":10001000,"beamDamp":25,"beamDeform":"FLT_MAX","beamStrength":275000},
            ["fh6r","fx5l", {"factor":-0.122,"steeringWheelLock":550, "inRate":1.15,"outRate":1.25, "inputSource":"velocita_steer"}],
            ["fh6l","fx5r", {"factor":0.122,"steeringWheelLock":550, "inRate":1.15,"outRate":1.25, "inputSource":"velocita_steer"}],
            //reference hydro on the normal steering input (keeps steering wheel animation + UI working); very weak so it adds no force
            {"beamSpring":1000,"beamDamp":5,"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
            ["f2r","f2l", {"factor":0.0001,"steeringWheelLock":550, "inRate":1.25,"outRate":1.25}],
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*14",
    },
},
