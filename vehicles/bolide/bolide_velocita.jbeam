    "bolide_mod_velocita_dse": {
        "information": {
            "authors": "Lincoln",
            "name": "Velocita Driving Electronics (TCS + ESC + Launch Control)",
            "value": 4500
        },
        "slotType": "bolide_mod",
        "controller": [
            [
                "fileName"
            ],
            [
                "drivingDynamics/CMU",
                {
                    "name": "CMU",
                    "debugSettings": {
                        "peerIP": "127.0.0.1"
                    }
                }
            ],
            [
                "drivingDynamics/sensors/sensorHub"
            ],
            [
                "drivingDynamics/sensors/virtualSensors",
                {
                    "name": "sensors"
                }
            ],
            [
                "drivingDynamics/sensors/vehicleData",
                {
                    "name": "vehicleData"
                }
            ],
            [
                "drivingDynamics/supervisors/components/motorTorqueControl",
                {
                    "name": "motorTorqueControl"
                }
            ],
            [
                "drivingDynamics/supervisors/components/brakeControl",
                {
                    "name": "brakeControl"
                }
            ],
            [
                "drivingDynamics/supervisors/tractionControl",
                {
                    "name": "tractionControl"
                }
            ],
            [
                "drivingDynamics/supervisors/slipProviders/virtualSpeedSlip"
            ],
            [
                "drivingDynamics/supervisors/yawControl",
                {
                    "name": "yawControl"
                }
            ],
            [
                "drivingDynamics/supervisors/yawProviders/STMEstimate"
            ],
            [
                "adaptiveBrakeLights"
            ],
            [
                "driveModes"
            ],
            [
                "drivingDynamics/actuators/activeDiffBias",
                {
                    "name": "activeBiasRear",
                    "differentialName": "differential_R",
                    "avDiffThreshold": 12
                }
            ],
            [
                "velocitaDiag"
            ],
            [
                "velocitaStraightLine"
            ]
        ],
        "vehicleData": {
            "skewStiffnessFront": 125000,
            "skewStiffnessRear": 215000
        },
        "tractionControl": {
            "tractionControlledMotors": [
                "mainEngine"
            ]
        },
        "motorTorqueControl": {
            "useForTractionControl": true,
            "tractionControl": {
                "wheelGroupSettings": [
                    [
                        "motorName",
                        "slipThreshold",
                        "kP",
                        "kI",
                        "kD",
                        "integralInCoef",
                        "integralOutCoef"
                    ],
                    [
                        "mainEngine",
                        0.1,
                        1.6,
                        2.6,
                        0.1,
                        20,
                        6
                    ]
                ]
            },
            "useForYawControl": true,
            "yawControl": {
                "yawControlledMotors": [
                    "mainEngine"
                ],
                "PIDSettings": [
                    [
                        "type",
                        "kP",
                        "kI",
                        "kD",
                        "integralInCoef",
                        "integralOutCoef"
                    ],
                    [
                        "yawAV",
                        1.5,
                        0.9,
                        0.0,
                        50,
                        20
                    ],
                    [
                        "slipAngle",
                        2.0,
                        1.0,
                        0.0,
                        10,
                        1
                    ]
                ],
                "yawAVThreshold": 0.3,
                "slipAngleThreshold": 0.05
            }
        },
        "brakeControl": {
            "useForTractionControl": false,
            "yawControl": {
                "PIDSettings": [
                    [
                        "type",
                        "kP",
                        "kI",
                        "kD",
                        "integralInCoef",
                        "integralOutCoef"
                    ],
                    [
                        "yawAV",
                        3.0,
                        0.8,
                        0.0,
                        100,
                        10
                    ],
                    [
                        "slipAngle",
                        2.0,
                        1.0,
                        0.0,
                        10,
                        1
                    ]
                ],
                "yawAVThreshold": 0.22,
                "slipAngleThreshold": 0.045
            }
        },
        "driveModes": {
            "enabledModes": [
                "safe",
                "sport",
                "topspeed",
                "off"
            ],
            "defaultMode": "safe",
            "defaultSettings": [
                [
                    "type"
                ],
                [
                    "controller",
                    {
                        "controllerName": "tractionControl",
                        "isEnabled": true
                    }
                ],
                [
                    "controller",
                    {
                        "controllerName": "yawControl",
                        "isEnabled": true
                    }
                ],
                [
                    "controller",
                    {
                        "controllerName": "motorTorqueControl",
                        "isEnabled": true,
                        "tractionControl": "default",
                        "yawControl": "default"
                    }
                ],
                [
                    "controller",
                    {
                        "controllerName": "brakeControl",
                        "isEnabled": true,
                        "yawControl": "default"
                    }
                ],
                [
                    "controller",
                    {
                        "controllerName": "twoStepLaunch",
                        "isEnabled": true,
                        "launchRPM": 5000
                    }
                ],
                [
                    "controller",
                    {
                        "controllerName": "activeBiasRear",
                        "isEnabled": true,
                        "maxBiasOffset": 0.15
                    }
                ],
                [
                    "controller",
                    {
                        "controllerName": "velocitaActiveWing",
                        "forceLowDrag": false
                    }
                ]
            ],
            "modes": {
                "safe": {
                    "name": "Full Assist",
                    "order": 10,
                    "settings": [
                        [
                            "type"
                        ],
                        [
                            "simpleControlButton",
                            {
                                "buttonId": "dse",
                                "uiName": "TCS / ESC",
                                "icon": "powertrain_esc",
                                "color": "238BE6",
                                "offColor": "343434"
                            }
                        ]
                    ]
                },
                "sport": {
                    "name": "Sport (more slide)",
                    "order": 20,
                    "settings": [
                        [
                            "type"
                        ],
                        [
                            "controller",
                            {
                                "controllerName": "activeBiasRear",
                                "isEnabled": true,
                                "maxBiasOffset": 0.2
                            }
                        ],
                        [
                            "controller",
                            {
                                "controllerName": "motorTorqueControl",
                                "tractionControl.wheelGroupSettings.mainEngine.slipThreshold": 0.22,
                                "yawControl.slipAngleThreshold": 0.09
                            }
                        ],
                        [
                            "controller",
                            {
                                "controllerName": "brakeControl",
                                "yawControl.slipAngleThreshold": 0.12,
                                "yawControl.yawAvThreshold": 0.5
                            }
                        ],
                        [
                            "simpleControlButton",
                            {
                                "buttonId": "dse",
                                "uiName": "TCS / ESC",
                                "icon": "powertrain_esc",
                                "color": "DA0C0C",
                                "offColor": "343434"
                            }
                        ]
                    ]
                },
                "off": {
                    "name": "TCS & ESC Off",
                    "order": 50,
                    "settings": [
                        [
                            "type"
                        ],
                        [
                            "controller",
                            {
                                "controllerName": "activeBiasRear",
                                "isEnabled": false,
                                "maxBiasOffset": 0.0
                            }
                        ],
                        [
                            "controller",
                            {
                                "controllerName": "tractionControl",
                                "isEnabled": false
                            }
                        ],
                        [
                            "controller",
                            {
                                "controllerName": "yawControl",
                                "isEnabled": false
                            }
                        ],
                        [
                            "controller",
                            {
                                "controllerName": "motorTorqueControl",
                                "isEnabled": false
                            }
                        ],
                        [
                            "controller",
                            {
                                "controllerName": "brakeControl",
                                "isEnabled": false
                            }
                        ],
                        [
                            "simpleControlButton",
                            {
                                "buttonId": "dse",
                                "uiName": "TCS / ESC",
                                "icon": "powertrain_esc",
                                "color": "999999",
                                "offColor": "343434"
                            }
                        ]
                    ]
                },
                "topspeed": {
                    "name": "Top Speed (wing flat)",
                    "order": 25,
                    "settings": [
                        [
                            "type"
                        ],
                        [
